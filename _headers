# Cloudflare static-assets headers.
# Never cache the HTML documents so a new deploy shows up immediately (the app is a single big
# index.html, so a stale copy hides every change). Fonts/images/mp3s keep normal caching.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate

# The pronunciation lexicon never changes once deployed — cache it hard so a writer
# who opens the Style Lenses pays its 265KB once and never again.
/data/*
  Cache-Control: public, max-age=31536000, immutable
