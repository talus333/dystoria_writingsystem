# Cloudflare static-assets headers.
# Never cache the HTML documents so a new deploy shows up immediately (the app is a single big
# index.html, so a stale copy hides every change). Fonts/images/mp3s keep normal caching.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate

# The bundled datasets never change once deployed — the pronouncing lexicon, the word
# frequency table, word origins, concreteness ratings, and the 345 shards of Webster's
# 1913. Cache them hard: a writer pays
# for each one at most once, ever. The corollary is that a path here is IMMUTABLE — a
# corrected table ships under a new filename (freq-en-2.txt), never over the old one.
/data/*
  Cache-Control: public, max-age=31536000, immutable
