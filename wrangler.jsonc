{
  "name": "dystoria",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  // Per-user + global daily AI counters. The binding name must stay AILIMITS —
  // worker.js reads env.AILIMITS, and dailyOkKV silently no-ops if it's missing.
  // Keys look like u:<user-id>:YYYY-MM-DD and global:YYYY-MM-DD, each a plain
  // integer with a 25h TTL, so they expire themselves.
  "kv_namespaces": [
    {
      "binding": "AILIMITS",
      "id": "78ca19a16cef4329b606f10bda345541"
    }
  ],
  // Whole-account ceiling across every user per day — a runaway-cost backstop,
  // not a per-person limit. Unset, globalDailyOk() returns true immediately.
  "vars": {
    "AI_GLOBAL_DAILY_CAP": "5000"
  }
}
